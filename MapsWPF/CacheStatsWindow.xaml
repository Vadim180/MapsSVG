<Window x:Class="MapsWPF.CacheStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cache Diagnostics" Height="418" Width="750"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        SizeToContent="Manual">
    <Border Background="#FF2B2B2B" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="0,10,0,10">
                <Border Background="#FF1E1E1E" BorderBrush="#FF3A3A3A" BorderThickness="1" CornerRadius="4" Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <StackPanel Orientation="Vertical" Margin="4">
                            <!-- Database info -->
                            <GroupBox Header="Database" Foreground="White"  Margin="0,0,0,8">
                                <Grid Margin="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="DB Path:" Foreground="#FFCCCCCC" />
                                    <TextBox x:Name="TextBlockDbPath" Grid.Row="0" Grid.Column="1" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="White" Margin="4,0,0,4"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="File Size:" Foreground="#FFCCCCCC" />
                                    <TextBlock x:Name="TextBlockFileSize" Grid.Row="1" Grid.Column="1" Foreground="White" Margin="4,0,0,4" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Last Modified:" Foreground="#FFCCCCCC" />
                                    <TextBlock x:Name="TextBlockLastModified" Grid.Row="2" Grid.Column="1" Foreground="White" Margin="4,0,0,4" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Tiles in DB:" Foreground="#FFCCCCCC" />
                                    <TextBlock x:Name="TextBlockTileCount" Grid.Row="3" Grid.Column="1" Foreground="White" Margin="4,0,0,0"/>
                                </Grid>
                            </GroupBox>

                            <!-- Statistics -->
                            <GroupBox Header="Statistics" Foreground="White" Margin="0,0,0,8">
                                <Grid Margin="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="From RAM" Foreground="#FFCCCCCC" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="From SQLite" Foreground="#FFCCCCCC" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="From Network" Foreground="#FFCCCCCC" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" x:Name="TextBlockFromRam" Foreground="White"  FontSize="14" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TextBlockFromSQLite" Foreground="White"  FontSize="14" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" x:Name="TextBlockFromNetwork" Foreground="White"  FontSize="14" />
                                </Grid>
                            </GroupBox>

                            <!-- Settings -->
                            <GroupBox Header="Settings" Foreground="White" >
                                <Grid Margin="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Mode:" Foreground="#FFCCCCCC" />
                                    <TextBlock x:Name="TextBlockMode" Grid.Row="0" Grid.Column="1" Foreground="White" Margin="4,0,0,4" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="UseMemoryCache:" Foreground="#FFCCCCCC" />
                                    <TextBlock x:Name="TextBlockUseMemoryCache" Grid.Row="1" Grid.Column="1" Foreground="White" Margin="4,0,0,4" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="CacheOnIdleRead:" Foreground="#FFCCCCCC" />
                                    <TextBlock x:Name="TextBlockCacheOnIdleRead" Grid.Row="2" Grid.Column="1" Foreground="White" Margin="4,0,0,4" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="BoostCacheEngine:" Foreground="#FFCCCCCC" />
                                    <TextBlock x:Name="TextBlockBoostCacheEngine" Grid.Row="3" Grid.Column="1" Foreground="White" Margin="4,0,0,4"/>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>