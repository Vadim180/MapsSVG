<Window x:Class="MapsWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MapsWPF"
        Height="775" Width="888"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        KeyboardNavigation.DirectionalNavigation="Once"
        xmlns:src="clr-namespace:MapsWPF"
        MinHeight="775" MinWidth="600" KeyUp="Window_KeyUp" PreviewKeyDown="Window_PreviewKeyDown">
    
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="250" />
        </Grid.ColumnDefinitions>

        <!--MAP-->
        <src:Map x:Name="MainMap" Zoom="7" MaxZoom="24" MinZoom="1" Grid.Column="0" Margin="0,0,5,0" />

        <!--SETTINGS-->
        <Grid Grid.Column="1" Margin="0,0,5,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <!--COORDINATES-->
            <GroupBox Grid.Row="0" Header="Coordinates" Name="GroupBoxCoordinates">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Label Height="28" Name="LabelLatLng" HorizontalAlignment="Left" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2"  VerticalAlignment="Center" MouseLeftButtonUp="Label_MouseLeftButtonUp" Margin="2,0,0,0">
                                Lat=0.00000000, Lng=0.00000000
                            </Label>

                            <Label Height="28" Name="LabelMGRS" HorizontalAlignment="Left" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Center" MouseLeftButtonUp="Label_MouseLeftButtonUp" Margin="2,0,0,0">
                                MGRS:
                            </Label>

                            <Label Height="28" Name="LabelUTM" HorizontalAlignment="Left" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" VerticalAlignment="Center" MouseLeftButtonUp="Label_MouseLeftButtonUp" Margin="2,0,0,0">
                                UTM:
                            </Label>

                            <Label Height="28" Name="LabelZoom" HorizontalAlignment="Left" Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="2,0,0,0">
                                Zoom:
                            </Label>


                        </Grid>
                    </GroupBox>

            <!--GMAP-->
            <GroupBox Grid.Row="1" Header="Gmap" Name="GroupBox2" >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Map Provider -->
                    <ComboBox Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" FontSize="12" Margin="5,5,5,0" VerticalContentAlignment="Center" Name="ComboBoxMapType" Height="24">
                        <ComboBox.SelectedItem>
                            <Binding Path="MapProvider" ElementName="MainMap">
                                <Binding.ValidationRules>
                                    <src:MapValidationRule x:Name="Validator" />
                                </Binding.ValidationRules>
                            </Binding>
                        </ComboBox.SelectedItem>
                    </ComboBox>

                    <!-- Map Mode -->
                    <ComboBox Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" FontSize="12" Height="24" Margin="5,5,5,0" VerticalContentAlignment="Center" Name="ComboBoxMode" DropDownClosed="comboBoxMode_DropDownClosed" />

                    <!-- Checkboxes -->
                    <StackPanel Grid.Column="0" Grid.Row="2" Margin="5,5,0,5" Orientation="Horizontal">
                        <CheckBox Name="CheckBoxDragMap" IsChecked="True" Height="16"  Checked="checkBoxDragMap_Checked" Unchecked="checkBoxDragMap_Unchecked">
                            Drag Map
                        </CheckBox>
                        <CheckBox  Margin="5,0,0,0" Name="CheckBoxCurrentMarker" Height="16" IsChecked="True" Checked="checkBoxCurrentMarker_Checked" Unchecked="checkBoxCurrentMarker_Unchecked">
                            Marker
                        </CheckBox>
                        <CheckBox  Margin="5,0,0,0" Name="CheckBoxDebug" Height="16" Checked="checkBox1_Checked" Unchecked="checkBox1_Unchecked">
                            Grid
                        </CheckBox>
                    </StackPanel>

                    <!-- Buttons -->
                    <Button Margin="5,0,5,5" Grid.Column="0" Grid.Row="3" Height="24"  Name="Button7" Click="button7_Click"  >
                        Save Picture
                    </Button>

                </Grid>
            </GroupBox>

            <!--CACHE-->
            <GroupBox Grid.Row="2" Header="Cache" Name="GroupBox4">
                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>


                            <Button  Margin="5,5,5,5" Grid.Column="0" Grid.Row="0" Name="Button3" Click="button3_Click" Height="24" >
                                Prefetch
                            </Button>
                            <Button Margin="0,5,5,5" Grid.Column="1" Grid.Row="0" Height="24" Name="Button4" Click="button4_Click">
                                Clear All
                            </Button>
                            <Button Margin="5,0,5,5" Grid.Column="0" Grid.Row="1" Name="Button5" Click="button5_Click" Height="24" >
                                Import
                            </Button>
                            <Button Margin="0,0,5,5" Grid.Column="1" Grid.Row="1" Name="Button6" Click="button6_Click" Height="24" >
                                Export
                            </Button>

                            <Button Margin="5,0,5,0" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" Name="ButtonCacheDiag" Click="buttonCacheDiag_Click" Height="24" >
                                Cache Stats
                            </Button>

                            <StackPanel Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="5,7,0,5">
                                <CheckBox Height="15" Name="CheckBoxCacheRoute" Checked="checkBoxCacheRoute_Checked" Unchecked="checkBoxCacheRoute_Checked" >
                                    routing
                                </CheckBox>
                                <CheckBox Margin="5,0,0,0" Height="15" Name="CheckBoxGeoCache" Checked="checkBoxGeoCache_Checked">
                                    geocoding
                                </CheckBox>
                            </StackPanel>

                        </Grid>
                    </GroupBox>

            <!--GO-->
            <GroupBox Grid.Row="3" Header="Go" Name="GroupBox1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- LATITUDE -->
                    <TextBox Margin="5,0,5,0" Grid.ColumnSpan="2" Grid.Row="0" Height="24" Name="TextBoxLat"  VerticalContentAlignment="Center" />
                    <!-- LABEL -->
                    <Label Margin="0,0,5,0" Grid.Row="0" Grid.Column="2"  HorizontalAlignment="Center" Name="Label2" HorizontalContentAlignment="Left" VerticalContentAlignment="Center">
                        Lat
                    </Label>

                    <!-- LONGITUDE -->
                    <TextBox Margin="5,0,5,0" Grid.ColumnSpan="2" Grid.Row="1" Name="TextBoxLng" Height="24" HorizontalContentAlignment="Left" VerticalContentAlignment="Center"/>
                    <!-- LABEL -->
                    <Label Margin="0,0,5,0" Grid.Row="1" Grid.Column="2"  HorizontalAlignment="Center" Name="Label3" HorizontalContentAlignment="Left" VerticalContentAlignment="Center">
                        Lng
                    </Label>

                    <!-- GEO -->
                    <TextBox Margin="5,0,5,0" Grid.ColumnSpan="2" Grid.Row="2" Height="24" Name="TextBoxGeo" VerticalContentAlignment="Center" KeyUp="textBoxGeo_KeyUp">
                        Kyiv
                    </TextBox>
                    <!-- LABEL -->
                    <Label Margin="0,0,5,0" Grid.Row="2" Grid.Column="2"  HorizontalAlignment="Center" Name="Label4" HorizontalContentAlignment="Left" VerticalContentAlignment="Center">
                        Geo
                    </Label>
                    
                    <!-- BUTTONS -->
                    <Button Margin="5,3,5,5" Grid.Column="0" Grid.Row="3"  Height="24" Name="Button2" Click="button2_Click">
                        Go
                    </Button>

                    <Button Margin="0,3,5,5"  Grid.Column="1" Grid.Row="3" Height="24" Name="ButtonSearch" Click="buttonSearch_Click">
                        Search
                    </Button>
                    
                    <Button Margin="0,3,5,5" Grid.Column="2" Grid.Row="3"  Height="24" Name="Button1" Click="button1_Click">
                        🔄
                    </Button>

                    <Button Margin="5,3,5,5" Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="3" Name="Button13" Height="24" VerticalAlignment="Bottom" Click="button13_Click">
                        Zoom Center
                    </Button>

                </Grid>
            </GroupBox>

            <!--MARKERS-->
            <GroupBox Grid.Row="4" Header="Markers" Name="Markers">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Button Margin="5,5,5,0" Grid.Column="0" Grid.Row="0" Name="Button8" Height="24" Click="button8_Click">Add Marker</Button>
                    <Button Margin="5,5,5,0" Grid.Column="1" Grid.Row="0" Name="Button10" Height="24" Click="button10_Click">
                        Clear All
                    </Button>
                    <CheckBox Margin="5,5,5,5" Grid.Column="0" Grid.Row="1" Name="CheckBoxPlace" Height="16" IsChecked="True">
                        place info
                    </CheckBox>

                </Grid>
            </GroupBox>

            <!--RAY-->
            <GroupBox Grid.Row="5" Header="Ray" Name="Ray">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Attack Angle -->
                    <Label Grid.Row="0" Grid.Column="0" Content="Кут атаки:" Margin="5,5,5,0" />
                    <TextBox Grid.Row="0" Grid.Column="1" Name="TextBoxAttackAngle" 
                             Height="24" Margin="5,5,5,0" 
                             VerticalContentAlignment="Center"
                             TextChanged="TextBoxAttackAngle_TextChanged" />

                    <!-- Ray Length -->
                    <Label Grid.Row="1" Grid.Column="0" Content="Довжина променя:" Margin="5,5,5,0" />
                    <TextBox Grid.Row="1" Grid.Column="1" Name="TextBoxRayLength" 
                             Height="24" Margin="5,5,5,0"
                             VerticalContentAlignment="Center"
                             TextChanged="TextBoxRayLength_TextChanged" />

                    <!-- Sector Radius -->
                    <Label Grid.Row="2" Grid.Column="0" Content="Радіус сектору:" Margin="5,5,5,0" />
                    <TextBox Grid.Row="2" Grid.Column="1" Name="TextBoxSectorRadius" 
                             Height="24" Margin="5,5,5,0"
                             VerticalContentAlignment="Center"
                             TextChanged="TextBoxSectorRadius_TextChanged" />

                    <!-- Sector Width -->
                    <Label Grid.Row="3" Grid.Column="0" Content="Ширина сектору:" Margin="5,5,5,0" />
                    <TextBox Grid.Row="3" Grid.Column="1" Name="TextBoxSectorWidth" 
                             Height="24" Margin="5,5,5,0"
                             VerticalContentAlignment="Center"
                             TextChanged="TextBoxSectorWidth_TextChanged" />

                    <!-- Rotate step -->
                    <Label Grid.Row="4" Grid.Column="0" Content="Крок повороту:" Margin="5,5,5,0" />
                    <TextBox Grid.Row="4" Grid.Column="1" Name="TextBoxRotateStep"
                             Height="24" Margin="5,5,5,0"
                             VerticalContentAlignment="Center"
                             TextChanged="TextBoxRotateStep_TextChanged" />

                    <!-- Rotate shift step (when Shift pressed) -->
                    <Label Grid.Row="5" Grid.Column="0" Content="Кроку повороту (Shift):" Margin="5,5,5,5" />
                    <TextBox Grid.Row="5" Grid.Column="1" Name="TextBoxRotateShiftStep"
                             Height="24" Margin="5,5,5,5"
                             VerticalContentAlignment="Center"
                             TextChanged="TextBoxRotateShiftStep_TextChanged" />

                </Grid>
            </GroupBox>

            <!--SPACER-->
            <Grid Grid.Row="6"/>
        
            <!--LOADING-->
            <GroupBox Grid.Row="7" Margin="0,0,0,5" Header="Loading" Name="GroupBox3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ProgressBar Margin="5,5,5,5" Grid.Row="0" Name="ProgressBar1" Height="10" IsIndeterminate="True"  />
                    <Label Margin="0,0,5,0" Height="24" Name="LabelCacheStats" Grid.Row="1" VerticalAlignment="Center" FontSize="10" Foreground="Gray">
                        Cache: RAM: 0 SQLite: 0 Net: 0
                    </Label>
                </Grid>
            </GroupBox>
        
        </Grid>
        


    </Grid>
</Window>